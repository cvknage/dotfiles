Outlook for Linux: notify on new mail via polling, since Push can't work here.

Confirmed live via DevTools that Outlook's Service Worker can never actually
complete a Push subscription in this Electron build: pushManager.subscribe()
throws "missing applicationServerKey, and gcm_sender_id not found in
manifest", and getSubscription() stays null even after granting real
engine-level notification permission (session.setPermissionRequestHandler /
setPermissionCheckHandler) and forcing a clean reload -- there's no working
push-service backend behind it here, independent of permission or how
Outlook triggers the attempt. That's not fixable from an app patch, so this
doesn't attempt to grant that permission at all; nothing here needs it.

Teams doesn't have this problem: it gets notifications for free because its
own live connection calls window.Notification directly the instant a message
arrives, no Push subscription involved. Outlook's page also keeps syncing
live while the window is backgrounded (that's what drives
004-outlook-unread-badge.patch's badge), so this recreates the same trigger
by reacting to that badge's own "unread-count" event instead of waiting on a
push message that will never come, then calling window.Notification
(preload.js's CustomNotification, already wired to a real native notification
and already honouring the app's disableNotifications setting) directly.

Reacting to outlookUnreadBadge's event rather than polling independently:
confirmed live that an earlier polling-and-diff version fired a notification
burst for every already-unread email on every app launch, because it seeded
its "already seen" baseline before Outlook's SPA had rendered the mail list
at all. Deferring the baseline to the first unread-count event -- which only
ever fires once outlookUnreadBadge has confirmed the Inbox element is
genuinely rendered -- fixes that. The body's subject+preview separator (an
em-dash on one line, not separate lines) was also settled by live testing:
neither a literal newline nor an actual <br> tag produces a line break in
this notification daemon, which renders the body as flat plain text.

--- /dev/null
+++ b/app/browser/tools/outlookNewMailNotifier.js
@@ -0,0 +1,154 @@
+// Fires a real desktop notification for new mail via the same window.Notification
+// override preload.js already installs (see CustomNotification in preload.js),
+// reacting to outlookUnreadBadge's own "unread-count" event instead of the
+// Push API -- Teams gets notifications for free because its own live
+// connection calls window.Notification directly the instant a message
+// arrives; Outlook only does that through a Service Worker Push subscription,
+// which Electron can't complete here (no working push-service backend,
+// confirmed live -- see this patch's own header). This recreates the same
+// "call Notification() the moment something new shows up" trigger by reading
+// the page instead, gated on the Inbox's own unread count actually rising.
+//
+// Known limitation: it scrapes whatever mail rows are currently rendered, so
+// it only really works while Mail/Inbox is the active view. If the Inbox
+// count rises while the user is looking at another folder or view, the scrape
+// finds that other folder's rows instead (missing the real new mail, and
+// potentially misreading unrelated already-read rows) -- not fixed here, no
+// reliable "is Inbox the active view" signal has been found in the DOM yet.
+//
+// Row-extraction technique (the time span as a layout anchor, subject right
+// before it, sender the nearest non-tag span before that) adapted from
+// dpeng/outlook-for-linux's outlookNewMailNotifier.js (MIT), which
+// reverse-engineered the same fixed leaf-span layout Outlook Web renders for
+// a mail row -- this targets the identical web app, so the same technique
+// applies regardless of which native wrapper loads it.
+
+const MAIL_ROW_SELECTOR = '[role="option"]';
+// Matches only a span whose ENTIRE text is a clock-shaped time (Outlook's own
+// time-column format for today's mail, e.g. "08:37" or "2:15 PM", optionally
+// prefixed with a day name for older-but-still-unread mail, e.g. "Wed
+// 08:37"). Anchored end-to-end so a subject or preview merely containing a
+// time-like substring (e.g. "Sync at 10:30", or a meeting invite's preview
+// text) can never be mistaken for the real time span -- unlike a bare
+// substring match, which a preview span sitting right after the real time
+// column made newly ambiguous once this module started reading it too.
+const TIME_ONLY_PATTERN = /^(?:[A-Za-z]{3,9}\.?\s+)?\d{1,2}:\d{2}(?:\s?[AP]M)?$/i;
+const SENDER_TAG_PATTERN =
+  /^(external|external sender|\[external\]|\[email\]|draft|forwarded|replied|re-sent)$/i;
+
+function normalizeText(value) {
+  return typeof value === "string" ? value.replace(/\s+/g, " ").trim() : "";
+}
+
+// Outlook renders each mail row as a set of leaf <span>s in a fixed order:
+// [tag?] sender subject time preview. The time span is the reliable anchor:
+// the subject sits immediately before it, the sender is the nearest non-tag
+// span before that, and the preview (if any) is the span right after it.
+function extractRowSummary(row) {
+  const aria = normalizeText(row.getAttribute("aria-label"));
+  if (!/^unread\b/i.test(aria)) return null;
+
+  const spans = Array.from(row.querySelectorAll("span"))
+    .filter((el) => el.children.length === 0)
+    .map((el) => normalizeText(el.textContent))
+    .filter(Boolean);
+  if (spans.length < 2) return null;
+
+  const timeIndex = spans.findIndex((text) => TIME_ONLY_PATTERN.test(text));
+  if (timeIndex < 1) return null;
+
+  const subject = spans[timeIndex - 1];
+  if (!subject) return null;
+
+  let sender = "";
+  for (let i = timeIndex - 2; i >= 0; i -= 1) {
+    if (!SENDER_TAG_PATTERN.test(spans[i])) {
+      sender = spans[i];
+      break;
+    }
+  }
+  if (!sender) sender = spans[0];
+
+  // The preview snippet (if any) is the leaf span right after the time, e.g.
+  // "sender subject 08:37 Hi, just following up on...". Folding it into the
+  // body gives an iOS-style notification: sender as the title, subject and a
+  // preview line underneath -- though see this patch's header for why that
+  // ends up on one line rather than two.
+  const preview = spans[timeIndex + 1] || "";
+
+  return {
+    title: sender,
+    // Confirmed live: this notification daemon renders the body as flat
+    // plain text -- neither a literal "\n" nor an actual <br> produces a
+    // line break (the <br> just shows up as literal characters), so there's
+    // no way to force separate lines here. A plain separator is the best
+    // readable fallback on one line.
+    body: preview ? `${subject} — ${preview}` : subject,
+    // spans[timeIndex] alone, not a substring match: TIME_ONLY_PATTERN is
+    // anchored end-to-end, so the whole span is already just the time (plus
+    // optional day prefix) with nothing else riding along in the key.
+    key: normalizeText(`${sender}|${subject}|${spans[timeIndex]}`).toLowerCase(),
+  };
+}
+
+function getUnreadMailSummaries() {
+  const rows = Array.from(document.querySelectorAll(MAIL_ROW_SELECTOR));
+  const summaries = [];
+  const seen = new Set();
+  for (const row of rows) {
+    const summary = extractRowSummary(row);
+    if (!summary || seen.has(summary.key)) continue;
+    seen.add(summary.key);
+    summaries.push(summary);
+  }
+  return summaries;
+}
+
+class OutlookNewMailNotifier {
+  #seenKeys = new Set();
+  #lastCount = -1;
+
+  init() {
+    globalThis.addEventListener("unread-count", (event) => this.#onUnreadCount(event));
+  }
+
+  #onUnreadCount(event) {
+    try {
+      const count = event?.detail?.number;
+      if (!Number.isFinite(count)) return;
+
+      // First event ever: whatever's already unread is the starting point,
+      // not mail that just arrived. outlookUnreadBadge only ever dispatches
+      // once it has confirmed the Inbox element is actually rendered, so
+      // there's no need to re-check readiness here -- by the time any event
+      // reaches this handler, the mail list has had its first real chance to
+      // render too.
+      const isBaseline = this.#lastCount === -1;
+      const rose = !isBaseline && count > this.#lastCount;
+      this.#lastCount = count;
+
+      for (const summary of getUnreadMailSummaries()) {
+        if (this.#seenKeys.has(summary.key)) continue;
+        // Always fold newly-visible rows into #seenKeys, even outside a rise
+        // (baseline, or the mail list still catching up to a count that
+        // already changed): otherwise a later rise would mistake them for
+        // new mail once they finally render.
+        this.#seenKeys.add(summary.key);
+        if (isBaseline || !rose) continue;
+
+        try {
+          // window.Notification is CustomNotification from this same
+          // preload.js -- it already honours disableNotifications and routes
+          // to a real native notification, so there's nothing else to wire.
+          new globalThis.Notification(summary.title, { body: summary.body });
+        } catch (error) {
+          console.error("OutlookNewMailNotifier: Notification failed", error);
+        }
+      }
+    } catch (error) {
+      console.error("OutlookNewMailNotifier: handling unread-count failed", error);
+    }
+  }
+}
+
+module.exports = new OutlookNewMailNotifier();

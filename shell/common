# vim: set filetype=sh :

# Aliases
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'

# load cargo bin directory
if [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# launch gitui themed
function gitui_themed() {
  OS="$(uname)"
  case $OS in
    "Linux")
      if [[ "$XDG_CURRENT_DESKTOP" == *GNOME* ]]; then
        if [[ $(gsettings get org.gnome.desktop.interface color-scheme) =~ "dark" ]]; then
          command gitui -t catppuccin-mocha.ron
        else
          command gitui -t catppuccin-frappe.ron
        fi
      else
        command gitui -t catppuccin-macchiato.ron
      fi
      ;;
    "Darwin")
      if [[ "$(osascript -l JavaScript -e "Application('System Events').appearancePreferences.darkMode.get()")" == "true" ]]; then
        command gitui -t catppuccin-mocha.ron
      else
        command gitui -t catppuccin-frappe.ron
      fi
      ;;
    *)
      command gitui -t catppuccin-macchiato.ron
      ;;
  esac
}
alias gitui="gitui_themed"

# export a sops secret when readable
function export_sops_secret() {
  [ -r "$2" ] || return 0
  export "$1=$(cat "$2")"
}

# shortcut for cloning in to a bare repo
function git-worktree-clone() {
  local Repository Directory GitDir RemoteHead DefaultBranch DirectoryExisted EmptyRemote arg SingleBranch=0
  local Usage='Usage: [--single-branch] <repository> [<directory>]'

  for arg; do
    if [ "$arg" = --single-branch ]; then
      SingleBranch=1
    elif [ -z "$Repository" ]; then
      Repository="$arg"
    elif [ -z "$Directory" ]; then
      Directory="$arg"
    else
      echo "$Usage"
      return 1
    fi
  done

  if [ -z "$Repository" ]; then
    echo "$Usage"
    return 1
  fi

  [ -n "$Directory" ] || Directory="$(basename "${Repository}" .git)"
  GitDir="${Directory}/.git"

  if [ -e "$GitDir" ]; then
    echo "${GitDir} already exists"
    return 1
  fi

  RemoteHead="$(git ls-remote --symref "${Repository}" HEAD)" || return 1
  DefaultBranch="$(printf '%s\n' "${RemoteHead}" | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2; exit }')"
  if [ -z "$DefaultBranch" ] && [ -n "$RemoteHead" ]; then
    DefaultBranch="$(git ls-remote --heads "${Repository}" |
      awk -v sha="$(printf '%s\n' "${RemoteHead}" | awk '{ print $1; exit }')" '$1 == sha { sub("refs/heads/", "", $2); print $2; exit }')"
  fi
  if [ -z "$DefaultBranch" ]; then
    EmptyRemote=1
    DefaultBranch="$(git config --get init.defaultBranch || echo main)"
  fi

  [ -d "${Directory}" ] && DirectoryExisted=1

  echo "Fetching ${Repository}..."
  if ! {
    git init --bare --quiet -b "${DefaultBranch}" "${GitDir}" &&
      git -C "${GitDir}" remote add origin "${Repository}" &&
      { [ "$SingleBranch" != 1 ] || git -C "${GitDir}" remote set-branches origin "${DefaultBranch}"; } &&
      git -C "${GitDir}" fetch --quiet origin &&
      if [ -n "$EmptyRemote" ]; then
        git -C "${GitDir}" config "branch.${DefaultBranch}.remote" origin &&
          git -C "${GitDir}" config "branch.${DefaultBranch}.merge" "refs/heads/${DefaultBranch}" &&
          git -C "${Directory}" worktree add --quiet --orphan -b "${DefaultBranch}" "${DefaultBranch}"
      else
        git -C "${GitDir}" remote set-head origin "${DefaultBranch}" &&
          git -C "${Directory}" worktree add --quiet --track -b "${DefaultBranch}" "${DefaultBranch}" "origin/${DefaultBranch}"
      fi
  }; then
    rm -rf "${GitDir}"
    [ -n "$DirectoryExisted" ] || rmdir "${Directory}"
    return 1
  fi
}
alias gwtc="git-worktree-clone"

if command -v docker >/dev/null; then
  # start/stop kind cluster
  function kind-funciton() {
    docker $1 $(docker ps -a | grep "kindest" | awk '{print $1}')
  }
  alias kind-stop="kind-funciton stop"
  alias kind-start="kind-funciton start"

  # fzf docker lods
  function docker-logs() {
    docker logs $(docker ps -a | fzf | awk {'print $1'}) -f
  }
  alias dockerl="docker-logs"
fi
